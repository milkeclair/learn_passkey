<%= form_with scope: :registration, url: registration_confirmation_email_path,
  data: { action: "submit->webauthn-register#confirmEmailStep", webauthn_register_target: "form" } do |f|
%>
  <%= f.label :confirm_code %>
  <%= f.text_field :confirm_code, data: { webauthn_register_target: "confirmCode" } %>

  <%= f.submit "submit" %>
<% end %>